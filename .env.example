NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# DingTalk OAuth and grader allowlist
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_REDIRECT_URI=https://exam.t12group.com/auth/dingtalk/callback
DINGTALK_GRADER_UNION_IDS=

# Feishu OAuth and messaging
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=https://exam.t12group.com/auth/feishu/callback
FEISHU_DOCUMENT_ID=

# Database (PostgreSQL 16 on the cloud server, never exposed publicly)
DB_CLIENT=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=t12_exams
DB_USER=t12_app
DB_PASSWORD=
DB_SSL=false

# Automatic portable backups (disabled until explicitly enabled)
T12_AUTO_BACKUP_ENABLED=false
T12_AUTO_BACKUP_STORAGE=database
T12_AUTO_BACKUP_INTERVAL_HOURS=24
T12_AUTO_BACKUP_RETENTION=7
T12_AUTO_BACKUP_START_DELAY_SECONDS=60
# Required only for filesystem storage; must be an absolute server path.
T12_AUTO_BACKUP_DIR=/var/backups/t12-online-exams/portable

# Notification worker (disabled until Feishu app messaging permission is verified)
T12_NOTIFICATION_WORKER_ENABLED=false
T12_NOTIFICATION_CHANNELS=feishu
T12_NOTIFICATION_INTERVAL_SECONDS=30
T12_NOTIFICATION_START_DELAY_SECONDS=15
T12_NOTIFICATION_BATCH_SIZE=10
T12_NOTIFICATION_MAX_ATTEMPTS=5
T12_NOTIFICATION_RETRY_BASE_SECONDS=60
T12_NOTIFICATION_STALE_AFTER_SECONDS=300
T12_PUBLIC_BASE_URL=https://exam.t12group.com
# Set once when enabling. Tasks created before this ISO timestamp stay pending and are not back-sent.
T12_NOTIFICATION_NOT_BEFORE=
